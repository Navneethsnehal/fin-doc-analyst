# auto: OpenAI when OPENAI_API_KEY is set, otherwise the deterministic fake provider.
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384

# memory (default, no database) or pgvector
VECTOR_BACKEND=memory
DATABASE_URL=postgresql://findoc:findoc@localhost:5432/findoc

LOAD_SAMPLES=true
LOG_LEVEL=INFO

# Optional LangSmith tracing. Leave tracing false for local runs and CI.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fin-doc-analyst
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
